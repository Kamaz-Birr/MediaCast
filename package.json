{
  "name": "mediacast-dlna-stack",
  "version": "1.3.0",
  "description": "JavaScript UPnP/DLNA casting stack with local media streaming",
  "main": "src/cli.js",
  "type": "module",
  "bin": {
    "mediacast": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "discover": "node src/cli.js discover",
    "formats": "node src/cli.js formats",
    "bundle": "esbuild src/cli.js --bundle --platform=node --format=cjs --external:readline/promises --outfile=dist/cli.bundle.cjs",
    "package": "npm run bundle && npx @yao-pkg/pkg dist/cli.bundle.cjs",
    "package:windows": "npm run package -- --targets node18-win-x64 --output dist/MediaCast-Windows-x64.exe",
    "package:mac:x64": "npm run package -- --targets node18-macos-x64 --output dist/MediaCast-macOS-x64",
    "package:mac:arm64": "npm run package -- --targets node18-macos-arm64 --output dist/MediaCast-macOS-arm64"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.15.3",
    "esbuild": "^0.25.8"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "assets": [
      "node_modules/node-unrar-js/esm/js/unrar.wasm"
    ]
  },
  "dependencies": {
    "axios": "^1.9.0",
    "commander": "^12.1.0",
    "fast-xml-parser": "^4.5.0",
    "mime-types": "^2.1.35",
    "node-ssdp": "^4.0.1",
    "node-unrar-js": "^2.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
